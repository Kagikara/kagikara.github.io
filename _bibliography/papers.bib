@article{yang2026paper1,
  title={Combinatorial Pure Exploration with Full-Bandit Feedback via Thompson Sampling},
  author={JIN XU, Yuhan Xie, Jiming Yang, Hongsong Yuan},
  journal={Under Review at AAAI 2027},             % 明确标注在投状态与目标会议
  year={2026},
  
  selected={true},                                 % 设为 true，使其显示在首页 Selected Publications
  pdf={https://drive.google.com/drive/folders/1m4A9SL3ZSNBI2Z0YteOy-Hikyt7EJbqa?usp=sharing},
  
  abstract={We study combinatorial pure exploration with full-bandit feedback, where simultaneously selecting multiple arms induces posterior correlations that render classical Thompson sampling inapplicable. Existing methods typically require extensive sampling to obtain accurate reward estimates, leading to high sample complexity. We propose a novel three-stage Thompson sampling based algorithm that first reduces posterior correlations through randomized exploration, then identifies an oversampled candidate set of size $\gamma L$ by Thompson sampling, and finally recovers the optimal $L$ arms by uniform sampling. The key idea is to reduce the identification difficulty from distinguishing $\Delta_{L,L+1}$ to distinguishing $\Delta_{L,\gamma L+1}$. We establish a  sample complexity bound of $O( (K/ \Delta_{L,L+1}^2)\log(K/\delta))$, and prove that it matches the information-theoretic lower bound $O ((K/ \Delta_{L,L+1}^2)\log(1/\delta) )$ up to a factor of $\log K$. Our analysis characterizes the effect of posterior correlations and shows how randomized exploration enables efficient Thompson sampling in the correlated setting.}
}

@article{ynag2026paper2,
  title={Contextual Combinatorial Bandits for Tag Combination Discovery in Short-Form Videos},
  author={JIN XU, Jiming Yang, Hongsong Yuan},
  journal={Submitted to WSDM 2027},             % 另一种标注写法，如 Submitted to [会议名]
  year={2026},
  
  selected={true},                                 % 同样设为 true 呈现在首页
  
  pdf={https://drive.google.com/drive/folders/1m4A9SL3ZSNBI2Z0YteOy-Hikyt7EJbqa?usp=sharing},                                % 对应 assets/pdf/paper2.pdf
  
  abstract={Identifying high-quality tag combinations is important for understanding which semantic characteristics contribute to user engagement in short-form videos. However, the large combinatorial action space and limited feedback make it challenging to efficiently discover effective tag combinations. In this paper, we formulate tag combination discovery as a contextual combinatorial bandit problem with full-bandit feedback, where each action consists of multiple tags and only the aggregate reward of the selected combination is observed. We develop a general action-selection framework that can accommodate different exploration strategies, including $\epsilon$-greedy, UCB, and Thompson sampling. Based on this framework, we develop a Thompson sampling-based algorithm that incorporates parameter uncertainty into action selection and maintains exploration throughout the learning process. We evaluate the proposed framework on the real-world \textit{KuaiRand} dataset. Experimental results show that Thompson sampling based methods generally achieve stronger performance than $\epsilon$-greedy and UCB.}
}